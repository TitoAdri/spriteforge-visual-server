# Never put actual values in this repository or in browser-side JavaScript.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional. Defaults are used when omitted.
SPRITEFORGE_PORT=3002
OPENAI_IMAGE_MODEL=gpt-image-2
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Animation 3: PixelEngine is deliberately disabled until a server-side key is set.
# Never expose this key in the browser or commit it to git.
PIXEL_ENGINE_API_KEY=
SPRITEFORGE_PIXELENGINE_ENABLED=false

# Required before the public API will generate. This is a temporary gate until
# application accounts/credits are implemented. Do not expose it in source.
SPRITEFORGE_GENERATOR_TOKEN=
