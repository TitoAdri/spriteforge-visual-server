# The backend is built by its own Docker context. Never copy it into the
# public Nginx image (this also prevents private data and source from being
# accidentally served as static files).
generator
ops
# Defensive exclusions for any future secrets/backups in the build context.
**/.env
**/.env.*
**/*backup*
**/*.db
**/*.sqlite
**/*.sqlite3
generator/.env
generator/evals/results
